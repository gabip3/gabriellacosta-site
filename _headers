# Security + cache headers for Cloudflare Pages.
# (GitHub Pages ignores this file — it does not support custom headers.
#  These take effect automatically once the site is deployed on Cloudflare Pages.)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Long-cache the fingerprint-free assets (they rarely change)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate HTML so edits go live immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
